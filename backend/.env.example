PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String (Prisma)
# Example: postgresql://postgres:password@localhost:5432/talent_iq?schema=public
# Or Neon / Supabase / Railway / AWS RDS: postgresql://user:password@ep-xyz.region.aws.neon.tech/talent_iq?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/talent_iq?schema=public"

# Optional: Legacy MongoDB Connection String (if restoring MongoDB)
DB_URL="mongodb+srv://<user>:<password>@cluster0.mongodb.net/MiTime"

# Stream Video & Chat
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Inngest Background Tasks
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key
